# Application
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1
# Comma-separated frontend URL(s), e.g. https://myassist-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app

# =============================================================================
# SUPABASE DATABASE — PENTING
# =============================================================================
# Di Dashboard Supabase ada 3 jenis connection string:
#
# 1. DIRECT (yang Anda lihat di dashboard):
#    postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#    → JANGAN dipakai jika error P1001 (IPv6 / firewall di jaringan Anda)
#
# 2. SESSION POOLER (port 5432) → isi DIRECT_URL (untuk prisma migrate)
#    postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# 3. TRANSACTION POOLER (port 6543) → isi DATABASE_URL (untuk NestJS runtime)
#    postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Lokasi di dashboard: Project Settings > Database > Connection string
# Pilih tab "Connection Pooling" (Session mode / Transaction mode)
#
# Jalankan `npm run db:test-connection` untuk menemukan region yang benar.
# =============================================================================

DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# Supabase
SUPABASE_URL="https://vkhyjuqmedclxzqulnsz.supabase.co"
# Secret key (server-side) — format baru: sb_secret_... atau legacy service_role JWT
# JANGAN expose ke frontend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Buat bucket otomatis saat startup jika belum ada (private bucket)
SUPABASE_STORAGE_BUCKET=ticket-attachments

# Storage: auto | supabase | local
# auto = Supabase jika SUPABASE_SERVICE_ROLE_KEY terisi, else local (development only)
STORAGE_DRIVER=supabase
LOCAL_STORAGE_PATH=uploads
# Public URL of this API (Render URL), used for signed download links
APP_URL=https://your-backend.onrender.com

# JWT (Phase 2)
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (used in WhatsApp / Telegram message links)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# MESSAGING — WhatsApp (Baileys now, Meta later) + Telegram Bot
# =============================================================================
# WhatsApp driver: baileys | meta | off
MESSAGING_WHATSAPP_DRIVER=baileys
# Persist Baileys auth session on disk (re-scan QR after wipe / redeploy without disk)
BAILEYS_AUTH_PATH=.baileys-auth
BAILEYS_AUTO_CONNECT=true

# Future Meta Cloud API (not implemented yet — keep for migration path)
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=

# Telegram Bot (create via @BotFather)
MESSAGING_TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Set webhook manually after deploy:
# https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<APP_URL>/api/v1/messaging/telegram/webhook
